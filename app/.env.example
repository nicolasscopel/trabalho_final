# Copie para `.env` (que NÃO é versionado) e preencha com os seus valores.
#   cp .env.example .env
# Nunca cole os valores reais no chat do agente nem faça commit do .env.

NODE_ENV=development
PORT=3000

# Neon > projeto > Connect: use a connection string *pooled* (host com "-pooler").
# Troque o final "?sslmode=require&channel_binding=require" por "?sslmode=verify-full"
# (o `pg` trata "require" como "verify-full" e emite um aviso; o channel binding
# já é ativado no código, em src/db/Database.ts).
# Formato: postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/NOME_DO_BANCO?sslmode=verify-full
DATABASE_URL=

# Conexões por instância (na Vercel cada instância serverless tem seu pool).
DB_POOL_MAX=5

# Segredo do HMAC do CPF (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# ATENÇÃO: trocar este valor invalida todos os cpf_hash já gravados.
CPF_PEPPER=

# Segredo para assinatura dos cookies de sessão (mínimo 32 caracteres).
# Obrigatório em produção; em desenvolvimento há fallback apenas local.
SESSION_SECRET=

# URL base usada nos links de verificação de e-mail (sem barra no final).
# Na Vercel, se omitida, usa automaticamente https://$VERCEL_PROJECT_PRODUCTION_URL ou https://$VERCEL_URL.
APP_BASE_URL=http://localhost:3000

# Opcional: define se /api/auth/cadastro e /api/auth/reenviar-verificacao retornam
# o link sandbox na resposta. Padrão: true em development, false em production.
# Para testar fluxo 100% fictício no deploy da Vercel sem servidor SMTP real, use true.
# EXPOR_SANDBOX_VERIFICACAO=false

# Opcional: banco SEPARADO (ex.: branch "teste" no Neon) para `npm test`
# rodar os testes de integração do schema. Eles rodam em um schema temporário
# dentro de uma transação e fazem ROLLBACK no final (não deixam resíduo).
TEST_DATABASE_URL=
